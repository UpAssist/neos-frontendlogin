prototype(UpAssist.Neos.FrontendLogin:Plugin.Profile) < prototype(Neos.Neos:Plugin) {
  package = 'UpAssist.Neos.FrontendLogin'
  controller = 'User'
  action = 'show'
  argumentNamespace = 'profile'
  # Lets the plugin build its URIs on pages without a routed node, e.g. the 404 page
  documentNode = ${documentNode}
}
